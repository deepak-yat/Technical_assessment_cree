# -----------------------------------------------------------------------------
# Hotel Reservation & Front Desk Management System - Environment Configuration
# -----------------------------------------------------------------------------

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# MongoDB Connection String (Replica Set required for ACID transactions)
MONGODB_URI=mongodb://localhost:27017/hotel_reservation?replicaSet=rs0&directConnection=true

# CORS Allowlist (comma-separated if multiple origins)
CORS_ORIGIN=http://localhost:5173

# Hotel Timezone (IANA timezone string e.g. UTC, America/New_York, Europe/London, Asia/Kolkata)
HOTEL_TIMEZONE=UTC

# Confirmation Policy: true -> auto-confirm reservations; false -> created as PENDING for staff confirmation
AUTO_CONFIRM=true

# JWT Configuration (Secret strings must be at least 32 characters)
JWT_ACCESS_SECRET=development_access_token_secret_key_at_least_32_characters_long
JWT_REFRESH_SECRET=development_refresh_token_secret_key_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
